# Copy to .env and fill in. All of these can also be passed as CLI flags.

# RPC endpoint used for BOTH sending and confirming transactions.
RPC=https://your-rpc-provider.example.com

# Path to the crank payer keypair (the account that signs + pays fees).
CRANK_KEYPAIR=./wallets/crank.json

# Priority fee in micro-lamports per compute unit (default 10000).
# PRIORITY_FEE=10000

# Hours between checkpoint+close maintenance passes (default 1, 0 disables).
# CLOSE_INTERVAL=1
